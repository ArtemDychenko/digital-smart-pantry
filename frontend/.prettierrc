{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "embeddedLanguageFormatting": "off",
  "singleQuote": true,
  "semi": true,
  "quoteProps": "preserve",
  "bracketSpacing": true,
  "trailingComma": "all",

  "overrides": [
    {
      "files": ".prettierrc|(*.json)",
      "options": {
        "parser": "jsonc",
        "singleQuote": false,
        "trailingComma": "none"
      }
    }
  ]
}
